<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.portsps2.app"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Método legacy de accesos directos en la pantalla de inicio -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- Android 11+: sin esto no se pueden detectar los emuladores instalados -->
    <queries>
        <package android:name="xyz.aethersx2.android" />
        <package android:name="xyz.aethersx2.tturnip" />
        <package android:name="xyz.trizle.nethersx2" />
        <package android:name="com.armsx2" />
        <package android:name="com.virtualapplications.play" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

    <application
        android:label="Ports PS2"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GameDetailActivity"
            android:exported="false" />
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Sirve los juegos porteados (files/games/) a los emuladores por
             content URI, con permiso temporal. No exportado. -->
        <provider
            android:name=".GameFileProvider"
            android:authorities="com.portsps2.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
